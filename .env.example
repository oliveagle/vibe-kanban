# Vibe Kanban Environment Configuration
# Copy this file to .env and modify the values as needed
# The .env file is loaded automatically when the server starts

# ============================================
# Local Authentication Credentials
# ============================================
# These credentials are used for local authentication mode (when not using OAuth)
# You can change these to customize the login credentials for your local deployment
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# ============================================
# Server Configuration
# ============================================
# Port configuration - set to 0 for auto-assignment
# PORT=3000
# BACKEND_PORT=3001
# FRONTEND_PORT=3000

# Host to bind the server to
# HOST=127.0.0.1

# ============================================
# Feature Flags
# ============================================
# Enable or disable local authentication (defaults to true)
# ENABLE_LOCAL_AUTH=true

# ============================================
# Analytics (Optional)
# ============================================
# PostHog analytics configuration (optional)
# POSTHOG_API_KEY=your_posthog_api_key
# POSTHOG_API_ENDPOINT=https://app.posthog.com

# ============================================
# Advanced/Development
# ============================================
# Shared API base for remote features (usually not needed for local development)
# VK_SHARED_API_BASE=

# Disable git worktree cleanup (for debugging)
# DISABLE_WORKTREE_ORPHAN_CLEANUP=1
