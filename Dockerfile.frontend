# Frontend Dockerfile - Nginx serving built React app
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY frontend/package*.json ./frontend/
COPY pnpm-lock.yaml ./

# Use npm instead of pnpm for Docker builds to avoid monorepo issues
# First, create a minimal package.json in frontend and install there
WORKDIR /app/frontend

# Copy frontend source
COPY frontend ./
COPY shared ../shared

# Install dependencies and build using npm
RUN npm install && npm run build

# Production stage - Nginx
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
