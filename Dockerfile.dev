# ============================================
# Vibe-Kanban Development Environment
# ============================================
#
# Layer 1: Base - Rust + system dependencies (tag: dev-base-v1.0.0)
# Layer 2: Dev tools - cargo-watch, etc. (tag: dev-tools-v1.0.0)
# Layer 3: Runtime - mount local code (tag: dev-runtime-v1.0.0)
#
# Usage:
#   # Build all layers (first time only)
#   just dev-build-all
#
#   # Or build specific layer
#   podman build -f Dockerfile.dev --target base --build-arg USE_MIRROR=true -t vibe-kanban:dev-base-v1.0.0 .
#   podman build -f Dockerfile.dev --target dev-tools --build-arg USE_MIRROR=true -t vibe-kanban:dev-tools-v1.0.0 .
#   podman build -f Dockerfile.dev --target dev-runtime --build-arg USE_MIRROR=true -t vibe-kanban:dev-runtime-v1.0.0 .
#
#   # Run with pre-built image
#   just dev-srv
#
# Version History:
#   v1.0.0 - Initial version with Rust 1.80, cargo-watch, Lightpanda, Node.js 20

# ============================================
# Layer 1: Base Image
# ============================================
FROM rust:1.80-slim-bookworm AS base

ARG USE_MIRROR=false

# Configure apt source
RUN if [ "$USE_MIRROR" = "true" ]; then \
        rm -f /etc/apt/sources.list.d/*.sources && \
        echo 'deb http://mirrors.tuna.tsinghua.edu.cn/debian/ bookworm main contrib non-free non-free-firmware' > /etc/apt/sources.list && \
        echo 'deb http://mirrors.tuna.tsinghua.edu.cn/debian/ bookworm-updates main contrib non-free non-free-firmware' >> /etc/apt/sources.list && \
        echo 'deb http://mirrors.tuna.tsinghua.edu.cn/debian-security/ bookworm-security main contrib non-free non-free-firmware' >> /etc/apt/sources.list; \
    fi

# Install system dependencies (cached layer)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    libclang-dev \
    clang \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ============================================
# Layer 2: Development Tools
# ============================================
FROM base AS dev-tools

# Install cargo-watch (cached layer, only rebuild when needed)
RUN cargo install cargo-watch

# Install Lightpanda
RUN curl -L -o /usr/local/bin/lightpanda \
    https://github.com/lightpanda-io/browser/releases/download/nightly/lightpanda-x86_64-linux \
    && chmod a+x /usr/local/bin/lightpanda

# Install Node.js for frontend tooling
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright
RUN mkdir -p /opt/playwright && cd /opt/playwright \
    && npm init -y && npm install playwright

ENV PATH="/opt/playwright/node_modules/.bin:${PATH}"

# ============================================
# Layer 3: Development Runtime
# ============================================
FROM dev-tools AS dev-runtime

ENV HOST=0.0.0.0
ENV PORT=3001
ENV RUST_LOG=debug
ENV DISABLE_WORKTREE_ORPHAN_CLEANUP=1

EXPOSE 3001

# Mount code at runtime, don't COPY
VOLUME ["/app"]

WORKDIR /app

# Default: watch and rebuild on code changes
CMD ["cargo", "watch", "-w", "crates", "-x", "run --bin server"]
