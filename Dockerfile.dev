# ============================================
# Vibe-Kanban Development Environment
# ============================================
#
# Layer 1: Base - Rust + system dependencies (tag: dev-base-v0.0.146)
# Layer 2: Runtime - mount local code (tag: dev-runtime-v0.0.146)
#
# Usage:
#   # Build all layers (first time only)
#   just dev-build-all
#
#   # Or build specific layer
#   podman build -f Dockerfile.dev --target base --build-arg USE_MIRROR=true -t vibe-kanban:dev-base-v0.0.146 .
#   podman build -f Dockerfile.dev --target dev-runtime --build-arg USE_MIRROR=true -t vibe-kanban:dev-runtime-v0.0.146 .
#
#   # Run with pre-built image
#   just dev-srv
#
# Version History:
#   v1.0.0 - Initial version with Rust 1.80, minimal dependencies

# ============================================
# Layer 1: Base Image
# ============================================
FROM rust:1.80-slim-bookworm AS base

ARG USE_MIRROR=false

# Configure apt source
RUN if [ "$USE_MIRROR" = "true" ]; then \
        rm -f /etc/apt/sources.list.d/*.sources && \
        echo 'deb http://mirrors.tuna.tsinghua.edu.cn/debian/ bookworm main contrib non-free non-free-firmware' > /etc/apt/sources.list && \
        echo 'deb http://mirrors.tuna.tsinghua.edu.cn/debian/ bookworm-updates main contrib non-free non-free-firmware' >> /etc/apt/sources.list && \
        echo 'deb http://mirrors.tuna.tsinghua.edu.cn/debian-security/ bookworm-security main contrib non-free non-free-firmware' >> /etc/apt/sources.list; \
    fi

# Install system dependencies (cached layer)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    libclang-dev \
    clang \
    git \
    curl \
    ca-certificates \
    podman \
    slirp4netns \
    uidmap \
    neovim \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20.x and npm/npx
# Use Tsinghua mirror when USE_MIRROR=true for faster downloads in China
RUN if [ "$USE_MIRROR" = "true" ]; then \
        curl -fsSL https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/v20.20.0/node-v20.20.0-linux-x64.tar.xz | tar -xJf - -C /usr/local --strip-components=1; \
    else \
        curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
        && apt-get install -y nodejs; \
    fi \
    && npm install -g npm@latest \
    && rm -rf /var/lib/apt/lists/*

# Configure npm to use Tsinghua mirror when USE_MIRROR=true
RUN if [ "$USE_MIRROR" = "true" ]; then \
        npm config set registry https://registry.npmmirror.com; \
    fi

# Install Rust nightly toolchain (matching rust-toolchain.toml)
# This prevents downloading on every container start
RUN rustup toolchain install nightly-2025-12-04 --component rustfmt,rustc,rust-analyzer,rust-src,rust-std,cargo

# Configure cargo to use Tsinghua mirror for crates.io (sparse index)
RUN mkdir -p /usr/local/cargo && \
    echo '[registries]' > /usr/local/cargo/config.toml && \
    echo 'tuna = { index = "sparse+https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/" }' >> /usr/local/cargo/config.toml && \
    echo '' >> /usr/local/cargo/config.toml && \
    echo '[source.crates-io]' >> /usr/local/cargo/config.toml && \
    echo 'replace-with = "tuna"' >> /usr/local/cargo/config.toml

# Install opencode globally (like production backend)
RUN npm install -g opencode-ai && \
    ln -s $(which opencode) /usr/local/bin/opencode || true

# Build MCP task server binary during image build
# Copy source code temporarily to build the binary
COPY . /tmp/build
WORKDIR /tmp/build

# Configure git to use HTTPS instead of SSH for GitHub (for corporate proxies)
# and set proxy if available
ARG HTTPS_PROXY
ARG HTTP_PROXY
RUN if [ -n "$HTTPS_PROXY" ]; then \
        git config --global http.proxy "$HTTPS_PROXY" && \
        git config --global https.proxy "$HTTPS_PROXY"; \
    fi && \
    git config --global url."https://github.com/".insteadOf "ssh://git@github.com/"

# Download dependencies first (cached layer), then build offline
# Run `cargo update` manually if you need to update dependencies
RUN cargo fetch && \
    cargo build --release --bin mcp_task_server --offline && \
    cp target/release/mcp_task_server /usr/local/bin/mcp_task_server && \
    chmod +x /usr/local/bin/mcp_task_server && \
    rm -rf /tmp/build

WORKDIR /app

# ============================================
# Layer 2: Development Runtime
# ============================================
FROM base AS dev-runtime

ENV HOST=0.0.0.0
ENV PORT=3001
ENV RUST_LOG=debug
ENV DISABLE_WORKTREE_ORPHAN_CLEANUP=1
ENV VIBE_BACKEND_URL=http://localhost:3000

# Configure cargo to use proxy for crate downloads (host proxy at port 1080)
# Note: This is separate from system proxy to avoid breaking Node.js fetch
RUN mkdir -p /usr/local/cargo && \
    echo '[http]' > /usr/local/cargo/config.toml && \
    echo 'proxy = "http://host.containers.internal:1080"' >> /usr/local/cargo/config.toml && \
    echo '' >> /usr/local/cargo/config.toml && \
    echo '[https]' >> /usr/local/cargo/config.toml && \
    echo 'proxy = "http://host.containers.internal:1080"' >> /usr/local/cargo/config.toml

EXPOSE 3001

# Mount code at runtime, don't COPY
VOLUME ["/app"]

WORKDIR /app

# Note: Install cargo-watch at runtime: cargo install cargo-watch
# Default: watch and rebuild on code changes
CMD ["sh", "-c", "cargo install cargo-watch && cargo watch -w crates -x 'run --bin server'"]
