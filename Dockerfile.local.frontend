# Local Frontend Dockerfile - 使用本地构建的前端文件
# 类似于 ghcr.io/oliveagle/vibe-kanban/frontend:latest
FROM nginx:alpine

# 复制本地构建的前端文件（需要预先构建 frontend）
COPY frontend/dist /usr/share/nginx/html

# 复制 nginx 配置（本地版本使用 host.containers.internal 代理）
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
