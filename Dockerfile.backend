# Backend Dockerfile - Rust server only
FROM rust:1.93-slim-bookworm AS builder

# Use Tsinghua mirror for local development (CI will use default)
ARG USE_MIRROR=false
RUN if [ "$USE_MIRROR" = "true" ]; then \
        sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources && \
        sed -i 's/security.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources; \
    fi

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    libclang-dev \
    clang \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy assets for rust_embed (must be before crates for correct relative path)
COPY assets ./assets

# Copy Cargo files for caching
COPY crates ./crates
COPY Cargo.toml Cargo.lock ./

# Build release binary (bundled sqlite is now in Cargo.toml)
RUN cargo build --release --bin server

# Runtime stage
FROM debian:bookworm-slim

# Use Tsinghua mirror for local development (CI will use default)
ARG USE_MIRROR=false
RUN if [ "$USE_MIRROR" = "true" ]; then \
        sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources && \
        sed -i 's/security.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources; \
    fi

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    tini \
    libssl3 \
    git \
    openssh-client \
    curl \
    wget \
    bash \
    neovim \
    nodejs \
    npm \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Install Lightpanda browser
RUN curl -L -o /usr/local/bin/lightpanda \
    https://github.com/lightpanda-io/browser/releases/download/nightly/lightpanda-x86_64-linux && \
    chmod a+x /usr/local/bin/lightpanda

# Install Playwright
RUN mkdir -p /opt && cd /opt && npm init -y && npm install playwright

# Install opencode via npm globally
RUN npm install -g opencode-ai && \
    ln -s $(which opencode) /usr/local/bin/opencode || true

# Install GitHub CLI
ENV GH_VERSION=2.86.0
RUN cd /tmp && \
    curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" -o gh.tar.gz && \
    tar -xzf gh.tar.gz && \
    mv "gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/ && \
    rm -rf "gh_${GH_VERSION}_linux_amd64" gh.tar.gz && \
    chmod +x /usr/local/bin/gh

# Create app user
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# Copy binary from builder
COPY --from=builder /app/target/release/server /usr/local/bin/server

# Create necessary directories
RUN mkdir -p /repos /app/data && \
    chown -R appuser:appgroup /repos /app

# Create symlink for home directory compatibility
RUN mkdir -p /home && ln -sf /repos /home/appuser

USER appuser

ENV HOST=0.0.0.0
ENV PORT=3000
ENV RUST_LOG=info

EXPOSE 3000

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["server"]
